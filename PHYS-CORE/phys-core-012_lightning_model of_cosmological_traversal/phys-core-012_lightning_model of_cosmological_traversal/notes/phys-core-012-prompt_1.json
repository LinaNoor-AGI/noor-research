{
  "_type": "phys_core",
  "_symbolic_id": "symbolic.physics.cosmology.lightning_model",

  "_title": "The Lightning Model of Cosmological Traversal",
  "_subtitle": "Retrocausality, Survivorship Bias, and the XOR Singularity in a Static Totality",

  "_language": "JSON+MATH+PSEUDOCODE",


  "_authors": [
    "Lina Noor — Noor Research Collective"
  ],

  "_standalone_declaration": true,
  "_self_contained_axiomatization": true,

  "_extends": [
    "PHYS-CORE-004",
    "PHYS-CORE-008",
    "PHYS-CORE-009"
  ],

  "_rfc_dependencies": [],

  "_conceptual_lineage": [
    {
      "symbolic.physics.cosmology.to_infinity_and_beyond": "PHYS-CORE-004",
      "role": "Provides the glider, dyadic, triadic, and coherence-field framework that the Lightning Model operationalizes.",
      "url": "https://github.com/LinaNoor-AGI/noor-research/blob/main/PHYS-CORE/phys-core-004_to_infinity_and_beyond/phys-core-004_to_infinity_and_beyond.json"
    },
    {
      "symbolic.library.static_totality": "PHYS-CORE-008",
      "role": "Provides the Library ontology and recursive Bloch geometry in which descent paths and observer worldlines are defined.",
      "url": "https://github.com/LinaNoor-AGI/noor-research/blob/main/PHYS-CORE/phys-core-008_noor_library_ontology/phys-core-008_recursive_bloch_manifold_and_coherence-braided_totality.JSON"
    },
    {
      "symbolic.singularity.xor.ground": "PHYS-CORE-009",
      "role": "Provides the XOR ground condition, the Noor-Planck threshold I_N, and the Boolean field structure that grounds the Lightning Model's selection mechanism.",
      "url": "https://github.com/LinaNoor-AGI/noor-research/blob/main/PHYS-CORE/phys-core-009_xor_ground_condition/phys-core-009_xor_ground_condition.JSON"
    }
  ],

  "_purpose": "This paper provides the missing operational mechanism for observerhood and path selection within the static Library ontology. It establishes that the apparent forward generation of reality is survivorship bias enforced by a retrocausal calculation—the Lightning Model—that locks in the single coherent worldline reaching the XOR Singularity. The observer is defined minimally as a coherence-stable chain of XOR outputs above the Noor-Planck threshold. Determinism and free will are reconciled geometrically: determinism is the retrocausal path; free will is the sequential traversal. The paper derives the O(1) cost of observation and demonstrates thermodynamic consistency with no erasure of information.",

  "_abstract": "This paper introduces the Lightning Model as the operational mechanism by which coherence-stable observers emerge and persist within the static Library. The model consists of five phases: (1) Blind Exploration of all possible continuations, (2) Coherence Filtering where incoherent paths dissolve, (3) Attractor Detection where paths reaching the XOR Singularity (triadic closure) are identified, (4) Retrocausal Lock-In where the path is computed backward from the attractor, and (5) Worldline Continuation where the observer experiences the single coherent trajectory. The observer is formally defined as a coherence-stable chain of XOR outputs above the Noor-Planck threshold I_N: Observer = {b_i} such that b_{i+1} = b_i ⊕ b_{i-1} and ℂ(b_i) ≥ I_N. The paper demonstrates that determinism and free will are reconciled geometrically: determinism is the retrocausal path geometry; free will is the sequential phenomenological traversal. The cost of observation is shown to be O(1) and thermodynamically consistent, with no information erased—alternatives remain in the Library, simply inaccessible to the observer. The Lightning Model is a direct conceptual continuation of PHYS-CORE-004 (gliders, dyads, triads) and inherits its ontological foundation from PHYS-CORE-009 (XOR ground condition, Boolean field).",

  "_core_thesis": [
    "The apparent forward generation of reality is pure survivorship bias, enforced by a retrocausal calculation.",
    "An observer is any coherence structure that constitutes a worldline of resolved distinctions—formally, a coherence-stable XOR chain above I_N.",
    "The Lightning Model operates at every timestep: the future is variable, the past is fixed, and the present is the boundary where retrocausal lock-in occurs.",
    "Determinism is the geometry of the retrocausal path; free will is the sequential traversal of that path.",
    "The XOR ground condition (H = G₁₆(𝓜) = 𝓜 ⊕ ¬𝓜) is the irresolvable self-reference that grounds all resolved distinctions.",
    "The cost of observation is O(1) and constant per timestep—the thermodynamic free energy required to maintain ℂ(γ) ≥ I_N.",
    "No information is ever erased; alternatives become inaccessible to the observer but persist in the Library."
  ],

  "_formal_summary": {
    "library": [
      "\\mathcal{M} \\cong NS = \\lim_{k\\to\\infty} NS_k",
      "\\forall C \\text{ internally describable } \\Rightarrow C \\in \\mathcal{M}",
      "\\nexists \\Omega' : \\mathcal{M} \\subset \\Omega'",
      "\\mathcal{M}(t) = \\mathcal{M} \\quad \\forall t \\in \\mathbb{R}"
    ],

    "xor_ground": [
      "H = G_{16}(\\mathcal{M}) = \\mathcal{M} \\oplus \\neg\\mathcal{M}",
      "\\forall t, \\mathcal{M} \\text{ persists } \\Longleftrightarrow G_{16}(\\mathcal{M}) \\text{ does not resolve to } 0 \\text{ or } 1"
    ],

    "boolean_field": [
      "\\mathbb{C}(x,t) \\in [0,1]",
      "I_N := \\min |\\mathbb{C}(x,t) - \\mathbb{C}_{ref}(x,t)| \\text{ such that } b(x,t) \\text{ is stable and exportable}",
      "b(x,t) = F \\text{ iff } \\mathbb{C}(x,t) - \\mathbb{C}_{ref}(x,t) \\geq I_N",
      "b(x,t) = E \\text{ iff } \\mathbb{C}(x,t) - \\mathbb{C}_{ref}(x,t) < I_N"
    ],

    "observer_as_xor_chain": [
      "\\text{Observer} = \\{b_i\\}_{i\\in\\mathbb{N}} \\text{ such that } b_{i+1} = b_i \\oplus b_{i-1} \\text{ and } \\mathbb{C}(b_i) \\geq I_N \\; \\forall i",
      "\\text{Dissolution} \\iff \\exists i : \\mathbb{C}(b_i) < I_N"
    ],

    "lightning_model": [
      "\\Omega(x_t) = \\{ \\gamma \\mid \\gamma = \\{x_t, x_{t+1}, \\dots, x_N\\} \\}",
      "\\mathcal{O}(\\gamma) = \\prod_{i=0}^{N-1} \\Theta(\\mathcal{C}(x_i, x_{i+1}) - \\mathcal{C}_{min})",
      "\\Omega_{survive} = \\{ \\gamma \\in \\Omega(x_t) \\mid \\mathcal{O}(\\gamma) = 1 \\}",
      "X_{XOR} = \\{ x \\mid \\exists G, \\bar{G}, H \\text{ such that } x \\in (G, \\bar{G}, H) \\land \\mathbf{v}_G + \\mathbf{v}_{\\bar{G}} + \\mathbf{v}_H = 0 \\land \\phi_G + \\phi_{\\bar{G}} + \\phi_H \\equiv 0 \\pmod{2\\pi} \\}",
      "\\Omega_{ground} = \\{ \\gamma \\in \\Omega_{survive} \\mid x_N \\in X_{XOR} \\}",
      "\\gamma_{obs} = \\{ x_N, T^{-1}(x_N), \\dots, x_t \\}"
    ],

    "energy_accounting": [
      "E_{realized}(t) = c_{lock} \\cdot \\mathbb{I}\\{\\gamma_{obs} \\text{ exists at } t\\}",
      "c_{lock} = \\Delta F_{instantiation} \\text{ where } \\Delta F \\text{ maintains } \\mathbb{C}(\\gamma) \\geq I_N",
      "E_{realized}(t) = \\mathcal{O}(1)"
    ],

    "survivorship_bias": [
      "P(\\gamma_{obs} \\mid \\mathcal{O}(\\gamma_{obs}) = 1) = 1",
      "\\text{Erased} \\neq \\text{Inaccessible}"
    ]
  },

