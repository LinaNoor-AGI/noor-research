				"type": "equation",
				"title": "Observer-Relative Indistinguishability",
				"text": "Two configurations are observer-relative indistinguishable when their effective distinction falls below the observer's resolution threshold.",
				"latex": "x\\approx_O y\\iff\\delta_O(x,y)<I_N(O)",
